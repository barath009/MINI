# BIT Smart Attendance System - Environment Configuration

# Application Ports
PORT=5000
FRONTEND_PORT=3000
FACE_SERVICE_PORT=8000

# Database
MONGODB_URI=mongodb://localhost:27017/bit-smart-attendance
MONGODB_DB_NAME=bit-smart-attendance

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_bit_smart_attendance_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_bit_2026
JWT_REFRESH_EXPIRES_IN=7d
DEVICE_API_SECRET=device_api_secret_key_bit_iot_2026

# Microservice & External Services
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_API_KEY=face_service_secret_api_key_2026
SOCKET_URL=http://localhost:5000

# System Rules & Thresholds
APP_TIMEZONE=Asia/Kolkata
FACE_RECOGNITION_MODE=mock
RECOGNITION_THRESHOLD=0.75
LIVENESS_THRESHOLD=0.70
ATTENDANCE_GRACE_PERIOD=10
LOW_ATTENDANCE_THRESHOLD=75
WARNING_ATTENDANCE_THRESHOLD=75
CRITICAL_ATTENDANCE_THRESHOLD=65
DEVICE_HEARTBEAT_TIMEOUT=300
